export default function QuadraticSequenceExplorer() {
  const { useState, useMemo } = React;

  const [teacherMode, setTeacherMode] = useState(false);
  const [difficulty, setDifficulty] = useState('Medium');
  const [showFirst, setShowFirst] = useState(false);
  const [showSecond, setShowSecond] = useState(false);
  const [showFormula, setShowFormula] = useState(false);
  const [seed, setSeed] = useState(1);

  const randomSequence = () => {
    setShowFirst(false);
    setShowSecond(false);
    setShowFormula(false);
    setSeed(Math.random());
  };

  const data = useMemo(() => {
    let a, b, c;

    if (difficulty === 'Easy') {
      a = [1, 2, 3][Math.floor(seed * 3) % 3];
      b = Math.floor(seed * 5);
      c = Math.floor(seed * 10);
    } else if (difficulty === 'Hard') {
      a = Math.floor(seed * 4) + 2;
      b = Math.floor(seed * 21) - 10;
      c = Math.floor(seed * 31) - 15;
    } else {
      a = Math.floor(seed * 3) + 1;
      b = Math.floor(seed * 11) - 5;
      c = Math.floor(seed * 21) - 5;
    }

    const sequence = [];

    for (let n = 1; n <= 8; n++) {
      sequence.push(a * n * n + b * n + c);
    }

    const first = sequence.slice(1).map((v, i) => v - sequence[i]);
    const second = first.slice(1).map((v, i) => v - first[i]);

    return { a, b, c, sequence, first, second };
  }, [seed, difficulty]);

  return (
    <div className="min-h-screen bg-slate-100 p-6">
      <div className="max-w-5xl mx-auto">
        <div className="bg-white rounded-3xl shadow-xl p-6">
          <div className="flex justify-between items-center mb-6">
            <div>
              <h1 className="text-3xl font-bold">Quadratic Sequence Explorer</h1>
              <p className="text-slate-500">Generate, reveal and investigate quadratic sequences.</p>
            </div>
            <button
              onClick={() => setTeacherMode(!teacherMode)}
              className="px-4 py-2 rounded-xl bg-slate-800 text-white"
            >
              {teacherMode ? 'Student View' : 'Teacher View'}
            </button>
          </div>

          {teacherMode && (
            <div className="bg-slate-50 rounded-2xl p-4 mb-6 border">
              <div className="flex gap-3 flex-wrap items-center">
                <select
                  value={difficulty}
                  onChange={(e) => setDifficulty(e.target.value)}
                  className="border rounded-xl px-3 py-2"
                >
                  <option>Easy</option>
                  <option>Medium</option>
                  <option>Hard</option>
                </select>

                <button
                  onClick={randomSequence}
                  className="px-4 py-2 rounded-xl bg-blue-600 text-white"
                >
                  Generate New Sequence
                </button>

                <button
                  onClick={() => setShowFormula(!showFormula)}
                  className="px-4 py-2 rounded-xl bg-purple-600 text-white"
                >
                  {showFormula ? 'Hide Formula' : 'Show Formula'}
                </button>
              </div>
            </div>
          )}

          <div className="overflow-auto">
            <table className="w-full text-center border-collapse">
              <tbody>
                <tr>
                  <td className="font-semibold p-3">Sequence</td>
                  {data.sequence.map((n, i) => (
                    <td key={i} className="p-3 text-xl font-medium text-blue-700">
                      {n}
                    </td>
                  ))}
                </tr>

                {showFirst && (
                  <tr>
                    <td className="font-semibold p-3">1st Diff</td>
                    <td></td>
                    {data.first.map((n, i) => (
                      <td key={i} className="p-3 text-orange-600 font-semibold">
                        {n}
                      </td>
                    ))}
                  </tr>
                )}

                {showSecond && (
                  <tr>
                    <td className="font-semibold p-3">2nd Diff</td>
                    <td></td>
                    <td></td>
                    {data.second.map((n, i) => (
                      <td key={i} className="p-3 text-green-700 font-bold bg-green-50 rounded-xl">
                        {n}
                      </td>
                    ))}
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          <div className="flex flex-wrap gap-3 justify-center mt-8">
            <button
              onClick={() => setShowFirst(true)}
              className="px-5 py-3 rounded-2xl bg-orange-500 text-white"
            >
              Reveal First Differences
            </button>

            <button
              onClick={() => {
                setShowFirst(true);
                setShowSecond(true);
              }}
              className="px-5 py-3 rounded-2xl bg-green-600 text-white"
            >
              Reveal Second Differences
            </button>

            <button
              onClick={() => {
                setShowFirst(false);
                setShowSecond(false);
              }}
              className="px-5 py-3 rounded-2xl bg-slate-600 text-white"
            >
              Reset Reveal
            </button>
          </div>

          <div className="mt-8 bg-slate-50 rounded-2xl p-4">
            <h2 className="font-bold text-lg mb-2">Challenge</h2>
            <p>Find the nth term of this sequence.</p>

            {showFormula && teacherMode && (
              <div className="mt-3 text-xl font-bold text-purple-700">
                {data.a}n² {data.b >= 0 ? '+' : '-'} {Math.abs(data.b)}n {data.c >= 0 ? '+' : '-'} {Math.abs(data.c)}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
